{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/contracts": ["./contracts/index.ts"],
      "@/contracts/*": ["./contracts/*"],
      "@snp/shared": ["./contracts/index.ts"],
      "@snp/shared/*": ["./contracts/*"],
      "@snpi/shared": ["./contracts/index.ts"],
      "@snpi/shared/*": ["./contracts/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "docs", "scripts", "infrastructure"]
}
