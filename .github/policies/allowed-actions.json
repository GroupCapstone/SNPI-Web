{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SNP-SMS GitHub Actions Allowlist Policy",
  "description": "Authoritative list of permitted GitHub Actions in the SNP-SMS repository per GitHub Well-Architected Governance standards. Every entry must be verified and full commit SHA pinned.",
  "version": "1.0.0",
  "policy": {
    "enforcement": "strict",
    "requireFullCommitSha": true,
    "allowUnpinnedTags": false,
    "allowFloatingBranches": false,
    "defaultWorkflowPermissions": "read-only"
  },
  "tiers": {
    "tier1_github_native": {
      "description": "Actions officially built and maintained by GitHub (github.com/actions/*, github.com/github/*)",
      "patterns": ["actions/*", "github/*"]
    },
    "tier2_verified_partner": {
      "description": "Actions published by verified marketplace organizations with active security programs",
      "patterns": ["docker/*", "trufflesecurity/*", "codecov/*"]
    },
    "tier3_exception_approved": {
      "description": "Explicitly reviewed, audited, and isolated community actions",
      "patterns": []
    }
  },
  "allowedActions": [
    {
      "action": "actions/checkout",
      "owner": "GitHub",
      "tier": "tier1_github_native",
      "pinnedSha": "11bd71901bbe5b1630ceea73d27597364c9af683",
      "version": "v4.2.2",
      "purpose": "Repository checkout with strict safe-directory boundaries"
    },
    {
      "action": "actions/setup-node",
      "owner": "GitHub",
      "tier": "tier1_github_native",
      "pinnedSha": "39370e3970a6d050c480ffad4ff0ed4d3fdee5af",
      "version": "v4.1.0",
      "purpose": "Node.js toolchain setup and npm cache hydration"
    },
    {
      "action": "actions/upload-artifact",
      "owner": "GitHub",
      "tier": "tier1_github_native",
      "pinnedSha": "b4b15b8c7c6ac21ea08fcf65892d2ee8f75cf882",
      "version": "v4.4.3",
      "purpose": "Secure ephemeral storage for build artifacts and test reports"
    },
    {
      "action": "actions/dependency-review-action",
      "owner": "GitHub",
      "tier": "tier1_github_native",
      "pinnedSha": "3b139cfc5fae8b618d3eae3675e383bb1769c019",
      "version": "v4.5.0",
      "purpose": "PR gate blocking vulnerable dependencies and restrictive licenses"
    },
    {
      "action": "actions/labeler",
      "owner": "GitHub",
      "tier": "tier1_github_native",
      "pinnedSha": "8558fd74291d67161a8a78ce36a881fa63b766a9",
      "version": "v5.0.0",
      "purpose": "Automated path-based triage labeling on pull requests"
    },
    {
      "action": "actions/stale",
      "owner": "GitHub",
      "tier": "tier1_github_native",
      "pinnedSha": "28ca1036281a5e5922ead5184a1bbf96e5fc984e",
      "version": "v9.0.0",
      "purpose": "Automated cleanup of inactive issues and draft pull requests"
    },
    {
      "action": "github/codeql-action/init",
      "owner": "GitHub Security",
      "tier": "tier1_github_native",
      "pinnedSha": "52cf1852265d99e9bea071b03366fc777a602909",
      "version": "codeql-bundle-v2.27.4",
      "purpose": "SAST analysis engine initialization for JavaScript/TypeScript"
    },
    {
      "action": "github/codeql-action/analyze",
      "owner": "GitHub Security",
      "tier": "tier1_github_native",
      "pinnedSha": "52cf1852265d99e9bea071b03366fc777a602909",
      "version": "codeql-bundle-v2.27.4",
      "purpose": "SARIF upload and security vulnerability detection"
    },
    {
      "action": "docker/setup-buildx-action",
