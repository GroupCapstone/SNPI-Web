      "purpose": "Multi-architecture OCI image build and provenance attestation"
    },
    {
      "action": "trufflesecurity/trufflehog",
      "owner": "Truffle Security Co.",
      "tier": "tier2_verified_partner",
      "pinnedSha": "ea68ca03c865c5f324e86e849ced20ed3cf9dbbb",
      "version": "v3.99.8",
      "purpose": "Deep git history scanning for verified high-entropy secrets and keys"
    }
  ]
}
