{
  "name": "enterprise-ghas-high-criticality",
  "description": "Standard GHAS Security Configuration for Mission-Critical and Regulated Repositories",
  "target_type": "repository",
  "features": {
    "secret_scanning": {
      "status": "enabled"
    },
    "secret_scanning_push_protection": {
      "status": "enabled",
      "delegated_bypass": {
        "status": "enabled",
        "authorized_roles": ["Security manager", "Admin"]
      }
    },
    "secret_scanning_validity_checks": {
      "status": "enabled"
    },
    "dependabot_alerts": {
      "status": "enabled"
    },
    "dependabot_security_updates": {
      "status": "enabled"
    },
    "code_scanning_default_setup": {
      "status": "enabled",
      "languages": ["javascript-typescript", "python"]
    }
  },
  "enforcement_targets": {
    "custom_properties": {
      "business_criticality": ["tier-1-mission-critical", "tier-2-internal"]
    }
  }
}
