{
  "name": "snpi-web",
  "version": "1.0.0",
  "private": true,
  "description": "SNPI School Management System - Next.js Web Portal & Developer Portal",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check .",
    "push": "tsx scripts/enhanced-secure-push.ts --deploy-vercel",
    "push:secure": "tsx scripts/enhanced-secure-push.ts --deploy-vercel",
    "push:prod": "tsx scripts/enhanced-secure-push.ts --deploy-vercel",
    "push:green": "tsx scripts/check-deploy-push-green.ts",
    "push:fast": "tsx scripts/check-deploy-push-green.ts --skip-ci-wait",
    "check:deploy:push": "tsx scripts/check-deploy-push-green.ts",
    "push:verify": "tsx scripts/verify-ci-status.ts",
    "release:github": "tsx scripts/enhanced-secure-push.ts",
    "deploy:vercel": "vercel deploy --archive=tgz",
    "deploy:vercel:prod": "vercel deploy --archive=tgz --prod",
    "release:all": "tsx scripts/enhanced-secure-push.ts --deploy-vercel",
    "security:scan": "tsx scripts/enhanced-secure-push.ts --skip-ci --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/google-sans": "^5.3.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-khmer": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@keyline-icons/react": "^2.5.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "3.4.17",
    "motion": "^14.9.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "read-excel-file": "^9.3.14",
    "sonner": "^2.0.8",
    "swr": "^2.3.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.4",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0",
    "lightningcss-linux-x64-musl": "^1.33.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
